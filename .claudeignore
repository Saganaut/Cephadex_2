# Claude Ignore File

## Excludes files/directories that Claude doesn't need to read for development tasks

## Virtual environments and dependencies

server/myenv/
frontend/node_modules/
**/__pycache__/
*.pyc
*.pyo

## Build outputs and generated files

frontend/dist/
frontend/build/
server/static/
*.min.js
*.min.css

## Log files

*.log
logs/
server/logs/

## Environment and sensitive files

.env
.env.local
.env.prod
.env.dev
.env.vault
*.key
*.pem

## OS and IDE files

.DS_Store
Thumbs.db
*.swp
*.swo
*~

## Package manager files

package-lock.json
*.lock
*.backup

## Cache directories

.cache/
.pytest_cache/
.eslintcache
**/.coverage
htmlcov/

## Docker and container files

*.tar
*.tar.gz

## Database files

*.db
*.sqlite
*.sqlite3

## Large binary files and media

*.pdf
*.mp4
*.avi
*.mov
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot

## Documentation that's not code-related

docs/images/
*.docx
*.pptx

## Backup files

*.bak
*.backup
*.orig

## Git files

.git/

## Test coverage reports

coverage/
.nyc_output/

## Temporary files

tmp/
temp/
*.tmp

## IDE specific files

.vscode/settings.json
.idea/
*.code-workspace

## Deployment and infrastructure

deploy/secrets/
*.pem
*.crt

## AI training data (likely large)

training_data/

## Aider cache

.aider.tags.cache.v4/
