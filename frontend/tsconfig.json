{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",

    "paths": {
      "@source/*": ["*"],
      "@components/*": ["components/*"],
      "@utils/*": ["src/Lib/utils/*"],
      "@contexts/*": ["contexts/*"],
      "@services/*": ["services/*"],
      "@hooks/*": ["hooks/*"],
      "@store/*": ["store/*"],
      "@common/*": ["components/Common/*"],
      "@pages/*": ["components/Pages/*"],
      "@app/*": ["components/App/*"],
      "@extract/*": ["components/App/Extract*"],
      "@assets/*": ["assets/*"],
      "@types/*": ["types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.jsx",
    "./tailwind.config.js"
  ],
  "exclude": ["node_modules"]
}
