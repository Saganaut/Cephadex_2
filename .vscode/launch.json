{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "5000",
        "--reload",
        "--log-level",
        "error"
      ],
      "jinja": false,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/server",
      "env": {
        // Add environment variables here if needed
      }
    },
    {
      "name": "React debug",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Python: Job Processing",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/job_processing.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/server",
      "env": {
        // Add environment variables here if needed
      },
      "args": [
        // Add arguments here if the script takes any arguments
      ]
    }
  ]
}
